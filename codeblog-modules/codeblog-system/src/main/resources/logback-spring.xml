<?xml version="1.0" encoding="UTF-8"?>
<!-- 系统管理服务日志：薄覆盖，通用 pattern/滚动策略见 codeblog-common-core 的 defaults.xml -->
<configuration>
    <property name="APP_NAME" value="codeblog-system"/>
    <property name="LOG_DIR" value="./logs"/>
    <include resource="codeblog/logback/defaults.xml"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
        <appender-ref ref="ERROR_FILE"/>
    </root>
</configuration>
